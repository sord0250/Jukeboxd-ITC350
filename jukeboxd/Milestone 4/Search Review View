USE jukeboxd;
CREATE OR REPLACE VIEW search AS 
SELECT 
  s.S_Name AS Song,
  s.S_Length,
  s.S_Genre AS Song_Genre,
  ar.ART_Name AS Artist,
  ar.ART_Genre AS Artist_Genre,
  al.AL_Name AS Album,
  al.AL_Genre AS Album_Genre
FROM song s
JOIN artist ar 
  ON s.ART_ID = ar.ART_ID
JOIN album al 
  ON s.AL_ID = al.AL_ID;
