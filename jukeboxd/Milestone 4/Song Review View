USE jukeboxd;
CREATE OR REPLACE VIEW song_review AS
SELECT 
    SONG.S_Name, 
    SONG.S_Genre, 
    REVIEW.R_Text, 
    REVIEW.R_Rating, 
    REVIEW.R_TimeCreated, 
    REVIEW.R_NumOfLikes, 
    ALBUM.AL_Name,
    ALBUM.AL_ID
FROM jukeboxd.SONG
JOIN jukeboxd.REVIEW 
    ON REVIEW.S_ID = SONG.S_ID
JOIN jukeboxd.ALBUM 
    ON ALBUM.AL_ID = SONG.AL_ID;
