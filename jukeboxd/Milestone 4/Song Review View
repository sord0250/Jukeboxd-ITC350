USE jukeboxd;
CREATE OR REPLACE VIEW song_review AS
SELECT 
    REVIEW.R_ID AS id,
    SONG.S_Name, 
    SONG.S_Genre, 
    REVIEW.R_Text, 
    REVIEW.R_Rating, 
    REVIEW.R_TimeCreated, 
    REVIEW.R_NumOfLikes, 
    ALBUM.AL_Name,
    ALBUM.AL_ID
FROM SONG
JOIN REVIEW 
    ON REVIEW.S_ID = SONG.S_ID
JOIN ALBUM 
    ON ALBUM.AL_ID = SONG.AL_ID;
ORDER BY RAND();
